# ============================================================
# 新蓝恒成网站 - Nginx 反向代理配置示例
# ------------------------------------------------------------
# 部署步骤：
#   1. 复制本文件到 /etc/nginx/sites-available/xinlan.conf
#   2. 修改 server_name 为实际域名
#   3. 创建软链：ln -s /etc/nginx/sites-available/xinlan.conf /etc/nginx/sites-enabled/
#   4. 测试配置：nginx -t
#   5. 重载：nginx -s reload
#
# HTTPS 配置（推荐）：
#   1. 安装 certbot：apt install certbot python3-certbot-nginx
#   2. 自动配置 SSL：certbot --nginx -d www.example.com -d example.com
#   3. certbot 会自动改写下方 listen 80 为 443 ssl 并补全证书路径
# ============================================================

# gzip 压缩配置（放在 http 块，此处放到 server 块上方便于单文件部署）
# 如已有全局 gzip 配置可删除此处
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 6;
gzip_min_length 1024;
gzip_types text/plain text/css text/xml text/javascript
           application/javascript application/x-javascript
           application/json application/xml application/xml+rss
           image/svg+xml font/woff font/woff2;

# 上游服务定义
upstream xinlan_frontend {
    server 127.0.0.1:3000;
    # 如需负载均衡可追加多台：server 127.0.0.1:3001;
    keepalive 32;
}

upstream xinlan_backend {
    server 127.0.0.1:3001;
    keepalive 32;
}

# ==================== HTTP 服务（前端 + API 反代） ====================
server {
    # 将 example.com 替换为实际域名
    server_name www.example.com example.com;

    listen 80;
    listen [::]:80;

    # 客户端上传文件大小限制（图片上传场景）
    client_max_body_size 10m;

    # 安全响应头
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    # 如启用 HTTPS，可加 HSTS（仅在 HTTPS 下生效）
    # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # -------------------- 后端 API 反向代理 --------------------
    # /api/* 转发到 Express 后端
    location /api/ {
        proxy_pass http://xinlan_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        # 代理超时
        proxy_connect_timeout 30s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # -------------------- 后端健康检查 --------------------
    location = /health {
        proxy_pass http://xinlan_backend/health;
        proxy_set_header Host $host;
        access_log off;
    }

    # -------------------- 用户上传图片 --------------------
    # /uploads/* 转发到后端静态文件服务
    location /uploads/ {
        proxy_pass http://xinlan_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 图片缓存（命中浏览器缓存，减轻后端压力）
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
        access_log off;
    }

    # -------------------- Next.js 静态资源缓存 --------------------
    # _next/static 含带 hash 的构建产物，可长期缓存
    location /_next/static/ {
        proxy_pass http://xinlan_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # 带 hash 的资源永久缓存
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    # -------------------- 前端 Next.js 应用 --------------------
    location / {
        proxy_pass http://xinlan_frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Connection "";
        # Next.js SSR 超时
        proxy_connect_timeout 30s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # -------------------- 隐藏敏感文件 --------------------
    location ~ /\.(?!well-known) {
        deny all;
        access_log off;
        log_not_found off;
    }

    # -------------------- 错误页面 --------------------
    error_page 502 503 504 /50x.html;
    location = /50x.html {
        default_type text/html;
        return 502 '<!DOCTYPE html><html><head><meta charset="utf-8"><title>服务暂时不可用</title></head><body style="font-family:sans-serif;text-align:center;padding:50px;"><h1>502 服务暂时不可用</h1><p>服务器正在维护中，请稍后重试。</p></body></html>';
    }
}

# ============================================================
# HTTPS 配置占位（使用 certbot 后会自动生成类似如下配置）
# ------------------------------------------------------------
# 取消注释并配置证书路径以启用 HTTPS：
#
# server {
#     server_name www.example.com example.com;
#     listen 443 ssl http2;
#     listen [::]:443 ssl http2;
#
#     # SSL 证书路径（certbot 自动生成）
#     ssl_certificate     /etc/letsencrypt/live/example.com/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/example.com/privkey.pem;
#     ssl_session_timeout 1d;
#     ssl_session_cache shared:MozSSL:10m;
#     ssl_session_tickets off;
#
#     # 现代加密套件
#     ssl_protocols TLSv1.2 TLSv1.3;
#     ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
#     ssl_prefer_server_ciphers off;
#
#     # HSTS（仅在 HTTPS 下生效）
#     add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
#
#     # 以下 location 配置与上方 HTTP server 块一致，可整体复制
#     # ...（复制上方 location /api/ /uploads/ /_next/static/ location / 等配置）
# }
