# 数据库连接字符串（开发环境 SQLite；生产环境使用 PostgreSQL）
DATABASE_URL="file:./dev.db"
# 生产 PostgreSQL 示例：
# DATABASE_URL="postgresql://app_user:strong-password@127.0.0.1:5432/xinlan?schema=public"

# JWT 密钥（生产环境必须 ≥48 位强随机串，定期轮换；轮换后所有会话失效需重新登录）
JWT_SECRET="xinlan-hengcheng-dev-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# 服务端口
PORT=3001

# 前端地址（CORS 白名单）
FRONTEND_URL="http://localhost:3000"

# 限流配置
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ==================== 种子账号口令（可选，安全治理） ====================
# 执行 prisma:seed 时使用的初始口令，必须通过统一密码策略
# （≥8 位、含大小写字母+数字+特殊字符、无 3 位连续/重复字符、不含用户名）
# 不配置时 seed 会为每个账号生成一次性随机强口令并打印到控制台（仅当次可见）
# SEED_ADMIN_PASSWORD="ChangeMe@2026"
# SEED_EDITOR_PASSWORD="ChangeMe@2026"

# ==================== 邮件通知（可选） ====================
# 留言/简历投递提交后向管理员发送通知邮件；以下四项全部配置才启用，否则自动跳过
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="noreply@example.com"
# SMTP_PASS="your-smtp-password"
# SMTP_FROM="noreply@example.com"
# NOTIFY_EMAIL="admin@example.com"
# SMTP_SECURE=false
