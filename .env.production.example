# ============================================================
# 新蓝恒成网站 - 生产环境变量模板
# ------------------------------------------------------------
# 使用方式：
#   1. 复制本文件为 .env.production（PM2）或填入 docker-compose.yml
#   2. 将所有标记 [必须修改] 的变量替换为真实值
#   3. JWT_SECRET 务必使用强随机字符串：openssl rand -hex 32
#   4. 切勿将 .env.production 提交到版本控制系统
# ============================================================


# ==================== 后端 (BACKEND) ====================

# 数据库连接字符串
# SQLite 示例：file:./prisma/prod.db （相对 backend 目录）
# MySQL 示例：mysql://user:password@localhost:3306/xinlan_prod
DATABASE_URL="file:./prisma/prod.db"

# JWT 签名密钥 [必须修改]
# 生成命令：openssl rand -hex 32
# 用于签发和校验用户登录 Token，泄露会导致会话被伪造
JWT_SECRET="CHANGE_ME_TO_A_STRONG_RANDOM_STRING"

# JWT 过期时间（如 7d / 12h / 30m）
JWT_EXPIRES_IN="7d"

# 后端服务监听端口
PORT=3001

# 前端访问地址（用于 CORS 白名单和 Cookie 跨域配置）
# 生产环境应填写实际域名，如 https://www.example.com
FRONTEND_URL="http://localhost:3000"

# 接口限流 - 时间窗口（毫秒，默认 15 分钟）
RATE_LIMIT_WINDOW_MS=900000

# 接口限流 - 单 IP 在时间窗口内最大请求数
RATE_LIMIT_MAX=100


# ==================== 前端 (FRONTEND) ====================

# 前端服务监听端口
PORT=3000

# Next.js 运行模式
NODE_ENV=production

# 监听地址（容器/服务器外部访问需设为 0.0.0.0）
HOSTNAME=0.0.0.0

# 后端 API 基础地址（浏览器端可见，无需保密）
# 生产环境改为实际后端地址，如 https://api.example.com/api
# 注意：Next.js 中 NEXT_PUBLIC_* 变量在构建时注入，运行时覆盖需在 Dockerfile 中处理
NEXT_PUBLIC_API_BASE="http://localhost:3001/api"
